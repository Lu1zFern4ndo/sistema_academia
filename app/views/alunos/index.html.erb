<p style="color: green"><%= notice %></p>

<% content_for :title, "Alunos" %>

<h1>Alunos</h1>
<%= link_to "Gerar Relatório PDF", alunos_path(format: :pdf), class: "btn btn-danger mb-3", target: "_blank" %>
<%= link_to "Gerar Arquivo CSV", alunos_path(format: :csv), class: "btn btn-success mb-3" %>
<table class="table table-striped table-hover mt-3">
  <thead class="table-dark">
    <tr>
      <th>Nome</th>
      <th>CPF</th>
      <th>Telefone</th>
      <th>Ações</th>
    </tr>
  </thead>
  
  <tbody>
    <% @alunos.each do |aluno| %>
      <tr>
        <td><%= aluno.nome %></td>
        <td><%= aluno.cpf %></td>
        <td><%= aluno.telefone %></td>
        <td>
          <%= link_to "Ver", aluno, class: "btn btn-info btn-sm" %>
          <%= link_to "Editar", edit_aluno_path(aluno), class: "btn btn-warning btn-sm" %>
          <%= link_to "Apagar", aluno, data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" }, class: "btn btn-danger btn-sm" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="mt-3">
  <%= paginate @alunos %>
</div>

<br>
<%= link_to "Novo Aluno", new_aluno_path, class: "btn btn-primary" %>