<p style="color: green"><%= notice %></p>

<% content_for :title, "Alunos" %>

<h1>Alunos</h1>
<%= link_to "Gerar Relatório PDF", alunos_path(format: :pdf), class: "btn btn-danger mb-3", target: "_blank" %>
<%= link_to "Gerar Arquivo CSV", alunos_path(format: :csv), class: "btn btn-success mb-3" %>
<div id="alunos">
  
  <% @alunos.each do |aluno| %>
    <%= render aluno %>
    <p>
      <%= link_to "Show this aluno", aluno %>
    </p>
  <% end %>
</div>
<%= paginate @alunos %>
<%= link_to "New aluno", new_aluno_path %>
