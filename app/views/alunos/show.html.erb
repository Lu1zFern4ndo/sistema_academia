<div class="card mt-4 shadow-sm">
  <div class="card-header bg-dark text-white">
    <h3 class="mb-0">Perfil do Aluno</h3>
  </div>
  
  <div class="card-body">
    <h4 class="card-title"><%= @aluno.nome %></h4>
    <hr>
    <p class="card-text"><strong>CPF:</strong> <%= @aluno.cpf %></p>
    <p class="card-text"><strong>Telefone:</strong> <%= @aluno.telefone %></p>
  </div>
  
  <div class="card-footer bg-light">
    <%= link_to "Editar Aluno", edit_aluno_path(@aluno), class: "btn btn-warning" %>
    <%= link_to "Voltar para a Lista", alunos_path, class: "btn btn-secondary ms-2" %>
    <%= link_to "Apagar", @aluno, data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja apagar este aluno?" }, class: "btn btn-danger float-end" %>
  </div>
</div>