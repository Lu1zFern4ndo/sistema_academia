<%= form_with(model: aluno) do |form| %>
  <% if aluno.errors.any? %>
    <div class="alert alert-danger">
      <h4>Opa! Encontramos <%= pluralize(aluno.errors.count, "erro", "erros") %>:</h4>
      <ul>
        <% aluno.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :nome, class: "form-label fw-bold" %>
    <%= form.text_field :nome, class: "form-control", placeholder: "Digite o nome completo" %>
  </div>

  <div class="mb-3">
    <%= form.label :cpf, "CPF", class: "form-label fw-bold" %>
    <%= form.text_field :cpf, class: "form-control", placeholder: "Apenas números" %>
  </div>

  <div class="mb-3">
    <%= form.label :telefone, class: "form-label fw-bold" %>
    <%= form.text_field :telefone, class: "form-control", placeholder: "(00) 00000-0000" %>
  </div>

  <div class="mt-4">
    <%= form.submit "Salvar Aluno", class: "btn btn-success" %>
    <%= link_to "Voltar", alunos_path, class: "btn btn-secondary ms-2" %>
  </div>
<% end %>