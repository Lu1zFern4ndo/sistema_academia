<div class="container mt-5">
  <div class="text-center mb-5">
    <h1 class="fw-bold">Bem-vindo</h1>
    <p class="text-muted fs-5">Escolha uma das opções de gerenciamento</p>
  </div>

  <div class="row text-center mt-4">
    <div class="col-md-4 mb-4">
      <div class="card shadow border-primary h-100 rounded-3">
        <div class="card-body p-4 d-flex flex-column">
          <h3 class="card-title fw-bold text-primary mb-3">Alunos</h3>
          <p class="card-text text-secondary mb-4">Cadastre novos alunos, edite dados pessoais e visualize perfis.</p>
          <%= link_to "Gerenciar Alunos", alunos_path, class: "btn btn-outline-primary btn-lg mt-auto w-100 fw-bold" %>
        </div>
      </div>
    </div>

    <div class="col-md-4 mb-4">
      <div class="card shadow border-success h-100 rounded-3">
        <div class="card-body p-4 d-flex flex-column">
          <h3 class="card-title fw-bold text-success mb-3">Atividades</h3>
          <p class="card-text text-secondary mb-4">Crie modalidades, configure preços e veja quem está matriculado.</p>
          <%= link_to "Gerenciar Atividades", atividade_fisicas_path, class: "btn btn-outline-success btn-lg mt-auto w-100 fw-bold" %>
        </div>
      </div>
    </div>

    <div class="col-md-4 mb-4">
      <div class="card shadow border-warning h-100 rounded-3">
        <div class="card-body p-4 d-flex flex-column">
          <h3 class="card-title fw-bold text-warning mb-3">Pagamentos</h3>
          <p class="card-text text-secondary mb-4">Receba mensalidades e efetue a matrícula automática no sistema.</p>
          <%= link_to "Gerenciar Pagamentos", pagamentos_path, class: "btn btn-outline-warning btn-lg mt-auto w-100 fw-bold" %>
        </div>
      </div>
    </div>
  </div>
</div>