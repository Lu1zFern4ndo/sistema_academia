<%= form_with(model: pagamento) do |form| %>
  <div class="mb-3">
    <%= form.label :aluno_id, "Vincular ao Aluno", class: "form-label fw-bold" %>
    <%= form.collection_select :aluno_id, Aluno.all, :id, :nome, { prompt: "Selecione um Aluno" }, { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= form.label :valor, class: "form-label fw-bold" %>
    <%= form.text_field :valor, class: "form-control", placeholder: "R$ 0,00" %>
  </div>

  <div class="mt-4">
    <%= form.submit "Salvar Pagamento", class: "btn btn-success" %>
    <%= link_to "Voltar", pagamentos_path, class: "btn btn-secondary ms-2" %>
  </div>
<% end %>